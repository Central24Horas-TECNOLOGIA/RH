# Ambiente
RH_APP_ENV=development
RH_LOG_LEVEL=INFO

# Servidor unico FastAPI + frontend
RH_SERVER_HOST=127.0.0.1
RH_SERVER_PORT=8010
RH_SERVER_RELOAD=false
RH_SERVE_FRONTEND=true
RH_FRONTEND_DIR=Front
RH_FRONTEND_API_BASE_URL=
RH_PROCESS_DOSSIER_AI_ENDPOINT=

# Banco SQL Server
RH_SQL_SERVER=SERVIDOR_SQL,1433
RH_SQL_DATABASE=RH_Provas
RH_SQL_DRIVER=ODBC Driver 18 for SQL Server
RH_SQL_TRUSTED_CONNECTION=false
RH_SQL_USERNAME=
RH_SQL_PASSWORD=
RH_SQL_ENCRYPT=no
RH_SQL_TRUST_SERVER_CERTIFICATE=true
RH_SQL_TIMEOUT_SECONDS=10

# Autenticacao local/bootstrap
RH_AUTH_USER=rh.local
RH_AUTH_PASSWORD=troque-esta-senha
RH_AUTH_TOKEN_SECRET=troque-este-segredo
RH_AUTH_TOKEN_TTL_MINUTES=480

# URL publica de candidatura
# Deixe vazio para links internos no mesmo host. Configure dominio/IP publico
# quando a pagina de candidatura precisar ser compartilhada fora do servidor.
RH_PUBLIC_FRONTEND_BASE_URL=
RH_PUBLIC_CANDIDATE_BASE_URL=

# CORS
# Com frontend servido pelo proprio backend, deixe vazio na maior parte dos casos.
# Preencha apenas para frontends externos autorizados, separados por virgula.
RH_CORS_ALLOW_ORIGINS=
RH_CORS_ALLOW_ORIGIN_REGEX=

# Caixa de curriculos por IMAP/Microsoft Graph
RH_EMAIL_INBOX_ENABLED=false
RH_EMAIL_INBOX_PROVIDER=microsoft365
RH_EMAIL_INBOX_PROTOCOL=imap
RH_EMAIL_INBOX_AUTH_MODE=oauth2
RH_EMAIL_INBOX_IMAP_HOST=outlook.office365.com
RH_EMAIL_INBOX_IMAP_PORT=993
RH_EMAIL_INBOX_ADDRESS=
RH_EMAIL_INBOX_USERNAME=
RH_EMAIL_INBOX_MAILBOX=INBOX
RH_EMAIL_INBOX_TENANT_ID=
RH_EMAIL_INBOX_CLIENT_ID=
RH_EMAIL_INBOX_CLIENT_SECRET_ENV=RH_EMAIL_CLIENT_SECRET
RH_EMAIL_INBOX_SCOPES=https://outlook.office365.com/.default
RH_EMAIL_INBOX_PASSWORD_ENV=RH_EMAIL_PASSWORD
RH_EMAIL_INBOX_MAX_MESSAGES=50
RH_EMAIL_INBOX_MAX_ATTACHMENT_MB=10
RH_EMAIL_INBOX_ATTACHMENTS_DIR=

# Microsoft Graph legado/alternativo
RH_EMAIL_GRAPH_TENANT_ID=
RH_EMAIL_GRAPH_CLIENT_ID=
RH_EMAIL_GRAPH_CLIENT_SECRET_ENV=RH_EMAIL_GRAPH_CLIENT_SECRET
RH_EMAIL_GRAPH_MAILBOX=
RH_EMAIL_GRAPH_SCOPE=https://graph.microsoft.com/.default
RH_EMAIL_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# SMTP
RH_EMAIL_SMTP_ENABLED=false
RH_EMAIL_SMTP_HOST=
RH_EMAIL_SMTP_PORT=587
RH_EMAIL_SMTP_USERNAME=
RH_EMAIL_SMTP_PASSWORD_ENV=RH_EMAIL_APP_PASSWORD
RH_EMAIL_SMTP_FROM=
RH_EMAIL_SMTP_USE_TLS=true
RH_EMAIL_SMTP_USE_SSL=false
