[APP]
environment = development

[SERVER]
host = 127.0.0.1
port = 8001
reload = true

[FRONTEND]
serve = true
dir = Front
api_base_url = http://127.0.0.1:8081
process_dossier_ai_endpoint =

[CORS]
# Com frontend servido pelo FastAPI, CORS normalmente pode ficar vazio.
# Configure apenas quando outro frontend ou dominio precisar consumir a API.
allow_origins =
allow_origin_regex =

[RH_DATABASE]
server = PAULO_TI\SQLEXPRESS
database = RH_Provas
driver = ODBC Driver 18 for SQL Server
trusted_connection = true
username =
password =
encrypt = no
trust_server_certificate = true
timeout_seconds = 10
connection_string = RH_Provas

[PUBLIC]
PUBLIC_FRONTEND_BASE_URL = http://127.0.0.1:5500
PUBLIC_CANDIDATE_BASE_URL = http://127.0.0.1:5500



RH_SQL_SERVER=192.168.5.62,1433
RH_SQL_DATABASE=RH_Provas_C24H
RH_SQL_DRIVER=ODBC Driver 18 for SQL Server
RH_SQL_TRUSTED_CONNECTION=0
